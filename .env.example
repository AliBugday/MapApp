# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_DB=mapapp
POSTGRES_USER=mapapp
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
# "backend" is required: the Next.js proxy forwards requests with Host: backend:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
# Internal URL the Next.js server uses to reach Django over the compose network
BACKEND_INTERNAL_URL=http://backend:8000
